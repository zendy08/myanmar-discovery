# Optional. If unset, a local secret is written to data/.session-secret.
AUTH_SECRET=

# --- Contact form (Resend, free tier: https://resend.com) ---
# API key from the Resend dashboard. Never commit .env.local.
RESEND_API_KEY=
# Must be a verified sender, e.g. Myanmar Discovery <notes@your-domain.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Rate limit (Upstash Redis, free tier: https://upstash.com) ---
# Skip these locally and the API will not rate-limit (it will not crash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Myanmar / global reach ---
# Vercel hostnames (*.vercel.app) often need a VPN in Myanmar.
# 1. Put the production site on a custom domain.
# 2. Point that domain at Vercel through Cloudflare DNS with the orange cloud ON
#    so readers hit Cloudflare, and Cloudflare fetches Vercel as origin.
# 3. Optional: deploy workers/contact.ts (`npx wrangler deploy`) and set the URL
#    below. The form uses it only when /api/contact cannot be reached.
NEXT_PUBLIC_CONTACT_FALLBACK_URL=
# Worker CORS allowlist — the public origin of this site, e.g. https://example.com
CONTACT_ALLOWED_ORIGIN=
